{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zentrylockers.internal/schemas/sem-specialist-output.schema.json",
  "title": "SemSpecialistOutput",
  "description": "Contrato de salida del subagente Claude sem-specialist, pasado a claude-code-action via --json-schema (ver .github/workflows/sem-specialist.yml). Debe reflejar EXACTAMENTE la interfaz TypeScript SemSpecialistOutput en src/employees/sem-specialist/sem-specialist-output.ts -- cualquier cambio en esa interfaz debe reflejarse aqui en el mismo commit (ver test/sem-specialist-output-schema.test.ts). Deliberadamente draft-07 (no 2020-12): el SDK de Claude Agent rechaza schemas que declaren un draft mas nuevo. IMPORTANTE (evitar romper el workflow): este fichero se embebe tal cual dentro de un string shell entre comillas simples (--json-schema entrecomillado) en .github/workflows/sem-specialist.yml -- ningun valor de texto de este JSON (descripciones incluidas) debe contener el caracter apostrofe. Usa definitions/ref (no defs) y additionalProperties false en todos los objetos, el mismo subconjunto que soporta src/core/json-schema-lite.ts.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "campaignFindings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "searchTermOpportunities": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "negativeKeywordRecommendations": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "budgetObservations": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "biddingObservations": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "adLandingAlignment": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "conversionRiskFindings": { "type": "array", "items": { "$ref": "#/definitions/finding" } },
    "prioritizedExperiments": { "type": "array", "items": { "$ref": "#/definitions/experiment" } },
    "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceItem" } },
    "unknowns": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "summary",
    "campaignFindings",
    "searchTermOpportunities",
    "negativeKeywordRecommendations",
    "budgetObservations",
    "biddingObservations",
    "adLandingAlignment",
    "conversionRiskFindings",
    "prioritizedExperiments",
    "evidence",
    "unknowns"
  ],
  "definitions": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } },
        "severity": { "type": "string", "enum": ["info", "low", "medium", "high"] }
      },
      "required": ["title", "description", "evidenceRefs", "severity"]
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "hypothesis": { "type": "string" },
        "expectedImpact": { "type": "string" },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "required": ["title", "hypothesis", "expectedImpact", "evidenceRefs", "priority"]
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "contextField": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["id", "contextField", "value"]
    }
  }
}
