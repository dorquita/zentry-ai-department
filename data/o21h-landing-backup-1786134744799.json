figure>\n<!-- /wp:image -->\n<h4>Banco de vestuario fenolico con perchero</h4>\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://zentrylockers.com/product/banco-vestuario-fenolico-perchero/\">Ver ficha</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:column -->\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:image {\"id\":1973\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://zentrylockers.com/wp-content/uploads/2026/08/banco-vestuario-fenolico-zapatero-principal.webp\" alt=\"Banco de vestuario fenolico con respaldo, perchero y zapatero Zentry\" class=\"wp-image-2030\"/></figure>\n<!-- /wp:image -->\n<h4>Banco de vestuario fenolico con zapatero</h4>\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://zentrylockers.com/product/banco-vestuario-fenolico-zapatero/\">Ver ficha</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons -->\n</div>\n<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\">\n<!-- wp:column -->\n<div class=\"wp-block-column\">\n<!-- wp:image {\"id\":1974\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"https://zentrylockers.com/wp-content/uploads/2026/08/banco-vestuario-melamina-principal.webp\" alt=\"Banco de vestuario de melamina Zentry\" class=\"wp-image-2031\"/></figure>\n<!-- /wp:image -->\n<h4>Banco de vestuario de melamina</h4>\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} -->\n<div class=\"wp-block-button is-style