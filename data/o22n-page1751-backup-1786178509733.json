, vestuarios y lockers inteligentes.</p>\n<!-- /wp:kadence/advancedheading -->\n\n<!-- wp:kadence/advancedbtn {\"hAlign\":\"left\",\"mhAlign\":\"center\",\"uniqueID\":\"1751_6f699e-3b\"} -->\n<div class=\"wp-block-kadence-advancedbtn kb-buttons-wrap kb-btns1751_6f699e-3b\"><!-- wp:kadence/singlebtn {\"uniqueID\":\"1751_6d309f-24\",\"text\":\"Pedir información\",\"link\":\"https://zentrylockers.com/contacto/\",\"inheritStyles\":\"inherit\"} /--></div>\n<!-- /wp:kadence/advancedbtn --></div></div>\n<!-- /wp:kadence/column -->\n<!-- /wp:kadence/rowlayout -->\n\n<!-- wp:kadence/rowlayout {\"uniqueID\":\"1751_2a9167-c8\",\"colLayout\":\"right-golden\",\"verticalAlignment\":\"middle\",\"borderRadius\":[8,8,8,8],\"padding\":[\"lg\",\"lg\",\"lg\",\"lg\"],\"borderStyle\":[{\"top\":[\"palette7\",\"\",1],\"right\":[\"palette7\",\"\",1],\"bottom\":[\"palette7\",\"\",1],\"left\":[\"palette7\",\"\",1],\"unit\":\"px\"}],\"kbVersion\":2} -->\n<!-- wp:kadence/column {\"borderWidth\":[\"\",\"\",\"\",\"\"],\"uniqueID\":\"1751_ddd941-e3\",\"textAlign\":[\"center\",\"\",\"\"],\"direction\":[\"horizontal\",\"\",\"\"],\"justifyContent\":[\"center\",\"\",\"\"],\"rowGap\":[10,\"\",\"\"],\"kbVersion\":2} -->\n<div class=\"wp-block-kadence-column kadence-column1751_ddd941-e3 kb-section-dir-horizontal\"><div class=\"kt-inside-inner-col\"><!-- wp:kadence/image {\"id\":1764,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"uniqueID\":\"1751_5626a5-3e\",\"marginDesktop\":[\"0\",\"0\",\"0\",\"0\"]} -->\n<figure class=\"wp-block-kadence-image kb-image1751_5626a5-3e size-full\"><img src=\"https://zentrylockers.com/wp-content/uploads/2026/05/KERONG-CAMBIO-2-1.png\" alt=\"\" class=\"kb-img wp-image-1764\"/></figure>\n<!-- /wp:kadence/image --></div></div>\n<!-- /wp:kadence/column -->\n\n<!-- wp:kadence/column {\"id\":2,\"borderWidth\":[\"\",\"\",\"\",\"\"],\"uniqueID\":\"1751_8af389-1c\",\"padding\":[\"\",\"xl\",\"\",\"\"],\"tabletPadding\":[\"\",\"0\",\"\",\"\"],\"kbVersion\":2} -->\n<div class=\"